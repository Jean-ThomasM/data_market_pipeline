# Sirene Extractor Configuration

# Output storage target (local or gcs)
STORAGE=local

# Google Cloud Project Configuration (required if STORAGE=gcs)
GCP_PROJECT_ID=your-gcp-project
GCS_BUCKET_NAME=your-gcs-bucket-name

# API Key (optional for future API integration)
# SIRENE_API_KEY=your-sirene-api-key
