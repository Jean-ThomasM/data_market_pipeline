# API Entreprise (Recherche Entreprises) Extractor Configuration

# BigQuery source dataset containing intermediate tables
INTERMEDIATE_DATASET_ID=your-gcp-project.intermediate_dev

# Google Cloud Project Configuration (required for BigQuery source queries)
GCP_PROJECT_ID=your-gcp-project

# Target Google Cloud Storage Bucket for results (persisted in raw/api_entreprise/)
GCS_BUCKET_NAME=your-gcs-bucket-name
