# Adzuna Extractor Configuration

# Adzuna API credentials (request on developer.adzuna.com)
ADZUNA_API_ID=your-adzuna-api-id
ADZUNA_API_KEY=your-adzuna-api-key

# Output storage target (local or gcs)
STORAGE=local

# Google Cloud Project Configuration (required if STORAGE=gcs)
# GCP_PROJECT_ID=your-gcp-project
# GCS_BUCKET_NAME=your-gcs-bucket-name
