main:
  params: [args]
  steps:
    - load_sirene:
        call: googleapis.bigquery.v2.jobs.insert
        args:
          projectId: "${project_id}"
          body:
            configuration:
              load:
                destinationTable:
                  projectId: "${project_id}"
                  datasetId: "${dataset_id}"
                  tableId: "staging_sirene"
                sourceUris:
                  - "gs://${bucket_name}/raw_sirene/*.csv"
                sourceFormat: "CSV"
                createDisposition: "CREATE_NEVER"
                writeDisposition: "WRITE_TRUNCATE"
                skipLeadingRows: 1
                maxBadRecords: 1000
        result: load_job

    # - list_loaded_files:
    #     call: googleapis.storage.v1.objects.list
    #     args:
    #       bucket: "${bucket_name}"
    #       prefix: "raw_sirene/"
    #       delimiter: "/"
    #     result: loaded_files
    # 
    # - move_loaded_files_to_done:
    #     for:
    #       value: loaded_file
    #       in: $${default(map.get(loaded_files, "items"), [])}
    #       steps:
    #         - copy_loaded_file:
    #             call: googleapis.storage.v1.objects.copy
    #             args:
    #               sourceBucket: "${bucket_name}"
    #               sourceObject: $${text.url_encode(loaded_file.name)}
    #               destinationBucket: "${bucket_name}"
    #               destinationObject: $${text.url_encode(text.replace_all(loaded_file.name, "raw_sirene/", "raw_sirene/done/"))}
    #             result: copied_file
    # 
    #         - delete_loaded_file:
    #             call: googleapis.storage.v1.objects.delete
    #             args:
    #               bucket: "${bucket_name}"
    #               object: $${text.url_encode(loaded_file.name)}

    - return_result:
        return:
          job_id: $${load_job.jobReference.jobId}
          dataset_id: "${dataset_id}"
          table_id: "staging_sirene"
          source: "gs://${bucket_name}/raw_sirene/*.csv"
